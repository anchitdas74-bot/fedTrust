        "    # 4. GWO Metaheuristic Threshold Optimization (F2-Recall Focused)\n",
        "    val_normal = X_test_norm[:2000]\n",
        "    val_fraud = X_fraud[:100]\n",
        "    X_val_gwo = np.vstack([val_normal, val_fraud])\n",
