        "\n",
        "# =====================================================================\n",
        "# 1. CST ANTENNA SIMULATION & RSSI ENGINE\n",
        "# =====================================================================\n",
        "class CSTAntennaEngine:\n",
        "    \"\"\"\n",
        "    Parses CST Studio S-Parameter ASCII/CSV exports or computes\n",
        "    closed-form electromagnetic equations for a 2.45 GHz Microstrip Patch.\n",
        "    \"\"\"\n",
        "    def __init__(self, cst_s11_filepath=\"cst_patch_s11.txt\", f0_ghz=2.45):\n",
        "        self.f0 = f0_ghz\n",
        "        self.c = 3e8\n",
        "        self.cst_filepath = cst_s11_filepath\n",
        "        self.frequencies, self.s11_db = self._load_or_generate_cst_data()\n",
        "\n",
        "    def _load_or_generate_cst_data(self):\n",
        "        if os.path.exists(self.cst_filepath):\n",
        "            data = np.loadtxt(self.cst_filepath, comments=['#', '!', '%'])\n",
        "            print(f\"[CST Engine] Loaded actual CST export from {self.cst_filepath}\")\n",
        "            return data[:, 0], data[:, 1]\n",
        "        else:\n",
        "            # High-fidelity CST response surrogate (FR-4 substrate, Q=35, f0=2.45 GHz)\n",
        "            freqs = np.linspace(2.0, 3.0, 200)\n",
        "            f_hz = freqs * 1e9\n",
        "            f0_hz = self.f0 * 1e9\n",
        "            gamma = f0_hz / 35.0\n",
        "            z = (f_hz - f0_hz) / (gamma / 2.0)\n",
        "            s11 = 20 * np.log10(np.clip(np.sqrt(z**2 / (1 + z**2)), 1e-4, 1.0))\n",
        "            return freqs, s11\n",
        "\n",
        "    def compute_received_rssi(self, distance_m, tx_power_dbm=14.0, path_loss_exp=2.2):\n",
        "        \"\"\"\n",
        "        Calculates received signal power (dBm) at the POS microstrip antenna\n",
        "        using log-distance path-loss model.\n",
        "        \"\"\"\n",
        "        if distance_m <= 0.05:\n",
        "            return float(round(tx_power_dbm - 8.0, 2))\n",
        "\n",
        "        wavelength = self.c / (self.f0 * 1e9)\n",
        "        d0 = 0.1  # 10 cm reference\n",
        "        pl0 = 20 * np.log10((4 * np.pi * d0) / wavelength)\n",
        "        pl = pl0 + 10 * path_loss_exp * np.log10(distance_m / d0)\n",
        "\n",
        "        rssi = tx_power_dbm - pl + np.random.normal(0, 0.5)\n",
        "        return float(round(rssi, 2))\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 2. DATASET INGESTION & NON-IID PARTITIONING\n",
        "# =====================================================================\n",
        "def load_credit_card_data(num_clients=3):\n",
        "    print(\"[Data Engine] Downloading Credit Card Fraud dataset...\")\n",
        "    url = \"https://raw.githubusercontent.com/nsethi31/Kaggle-Data-Credit-Card-Fraud-Detection/master/creditcard.csv\"\n",
        "    try:\n",
        "        df = pd.read_csv(url)\n",
        "    except Exception:\n",
        "        df = pd.read_csv(\"creditcard.csv\")\n",
        "\n",
        "    feature_cols = [col for col in df.columns if col not in ['Time', 'Class']]\n",
        "    X = df[feature_cols].values\n",
        "    y = df['Class'].values\n",
        "\n",
        "    scaler = StandardScaler()\n",
        "    X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "    X_normal = X_scaled[y == 0]\n",
        "    X_fraud = X_scaled[y == 1]\n",
        "\n",
        "    # Split normal data: 80% train (for FL Autoencoder), 20% test/val\n",
        "    X_train_norm, X_test_norm = train_test_split(X_normal, test_size=0.2, random_state=42)\n",
        "\n",
        "    # Non-IID Partition across 3 Bank Nodes (Sorted by transaction amount)\n",
        "    sort_idx = np.argsort(X_train_norm[:, -1])\n",
        "    X_train_sorted = X_train_norm[sort_idx]\n",
        "    client_data = np.array_split(X_train_sorted, num_clients)\n",
        "\n",
        "    print(f\"[Data Engine] Ingested {len(X)} records (Normal: {len(X_normal)}, Fraud: {len(X_fraud)})\")\n",
        "    print(f\"[Data Engine] Partitioned Non-IID across {num_clients} Banks: {[len(c) for c in client_data]} records each.\")\n",
        "    return client_data, X_test_norm, X_fraud, feature_cols, scaler\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 3. PYTORCH AUTOENCODER MODEL\n",
        "# =====================================================================\n",
        "class TransactionAutoencoder(nn.Module):\n",
        "    def __init__(self, input_dim=29):\n",
        "        super().__init__()\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Linear(input_dim, 16),\n",
        "            nn.BatchNorm1d(16),\n",
        "            nn.LeakyReLU(0.1),\n",
        "            nn.Linear(16, 8),\n",
        "            nn.BatchNorm1d(8),\n",
        "            nn.LeakyReLU(0.1),\n",
        "            nn.Linear(8, 4)\n",
        "        )\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(4, 8),\n",
        "            nn.BatchNorm1d(8),\n",
        "            nn.LeakyReLU(0.1),\n",
        "            nn.Linear(8, 16),\n",
        "            nn.BatchNorm1d(16),\n",
        "            nn.LeakyReLU(0.1),\n",
        "            nn.Linear(16, input_dim)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.decoder(self.encoder(x))\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 4. FEDERATED LEARNING TRAINER (FedAvg)\n",
        "# =====================================================================\n",
        "class FederatedTrainer:\n",
        "    def __init__(self, client_data, input_dim=29):\n",
        "        self.client_data = client_data\n",
        "        self.num_clients = len(client_data)\n",
        "        self.global_model = TransactionAutoencoder(input_dim=input_dim)\n",
        "\n",
        "    def train(self, rounds=10, local_epochs=5, batch_size=128, lr=0.003):\n",
        "        \"\"\"\n",
        "        Executes decentralized Federated Averaging (FedAvg) over multiple rounds\n",
        "        with local client training and learning rate scheduling.\n",
        "        \"\"\"\n",
        "        print(f\"\\n[FL Engine] Starting Extended Decentralized Training ({rounds} Rounds × {local_epochs} Local Epochs)...\")\n",
        "\n",
        "        for r in range(1, rounds + 1):\n",
        "            local_weights = []\n",
        "            round_losses = []\n",
        "\n",
        "            for cid in range(self.num_clients):\n",
        "                client_net = copy.deepcopy(self.global_model)\n",
        "                client_net.train()\n",
        "\n",
        "                tensor_data = torch.tensor(self.client_data[cid], dtype=torch.float32)\n",
        "                loader = DataLoader(TensorDataset(tensor_data), batch_size=batch_size, shuffle=True)\n",
        "\n",
        "                optimizer = torch.optim.Adam(client_net.parameters(), lr=lr, weight_decay=1e-5)\n",
        "                scheduler = torch.optim.lr_scheduler.ExponentialLR(optimizer, gamma=0.95)\n",
        "                criterion = nn.MSELoss()\n",
        "\n",
        "                epoch_losses = []\n",
        "                for epoch in range(local_epochs):\n",
        "                    batch_losses = []\n",
        "                    for batch in loader:\n",
        "                        x = batch[0]\n",
        "                        optimizer.zero_grad()\n",
        "                        recon = client_net(x)\n",
        "                        loss = criterion(recon, x)\n",
        "                        loss.backward()\n",
        "                        optimizer.step()\n",
        "                        batch_losses.append(loss.item())\n",
        "                    epoch_losses.append(np.mean(batch_losses))\n",
        "                    scheduler.step()\n",
        "\n",
        "                avg_client_loss = np.mean(epoch_losses)\n",
        "                round_losses.append(avg_client_loss)\n",
        "                local_weights.append(client_net.state_dict())\n",
        "\n",
        "            # FedAvg Server Aggregation\n",
        "            global_state = copy.deepcopy(local_weights[0])\n",
        "            for key in global_state.keys():\n",
        "                for c in range(1, self.num_clients):\n",
        "                    global_state[key] += local_weights[c][key]\n",
        "                global_state[key] = torch.div(global_state[key], self.num_clients)\n",
        "\n",
        "            self.global_model.load_state_dict(global_state)\n",
        "            print(f\"  ── Round {r:02d}/{rounds:02d} | Mean Global Loss: {np.mean(round_losses):.6f} | Client Losses: {[round(l, 5) for l in round_losses]}\")\n",
        "\n",
        "        return self.global_model\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 5. GREY WOLF OPTIMIZER (GWO) FOR DYNAMIC THRESHOLD TUNING\n",
        "# =====================================================================\n",
        "class GreyWolfThresholdOptimizer:\n",
        "    \"\"\"\n",
        "    Bio-inspired metaheuristic search algorithm (Mirjalili et al., 2014).\n",
        "    Optimizes the decision boundary tau using an F2-Score fitness metric\n",
        "    to weight fraud recall over precision.\n",
        "    \"\"\"\n",
        "    def __init__(self, num_wolves=15, max_iter=20, search_min=0.8, search_max=2.5):\n",
        "        self.num_wolves = num_wolves\n",
        "        self.max_iter = max_iter\n",
        "        self.search_min = search_min\n",
        "        self.search_max = search_max\n",
        "\n",
        "    def _fitness_function(self, tau, reconstruction_errors, ground_truth):\n",
        "        \"\"\"Calculates F2-Score (Recall weighted twice as heavily as Precision).\"\"\"\n",
        "        y_pred = (reconstruction_errors >= tau).astype(int)\n",
        "        if np.sum(y_pred) == 0:\n",
        "            return 0.0\n",
        "        return fbeta_score(ground_truth, y_pred, beta=2.0, zero_division=0)\n",
        "\n",
        "    def optimize(self, reconstruction_errors: np.ndarray, ground_truth: np.ndarray):\n",
        "        print(f\"\\n[GWO Engine] Initializing pack of {self.num_wolves} wolves across search space [{self.search_min}, {self.search_max}]...\")\n",
        "\n",
        "        # 1. Initialize wolf positions randomly within bounds\n",
        "        wolves = np.random.uniform(self.search_min, self.search_max, self.num_wolves)\n",
        "        fitness = np.zeros(self.num_wolves)\n",
        "\n",
        "        for i in range(self.num_wolves):\n",
        "            fitness[i] = self._fitness_function(wolves[i], reconstruction_errors, ground_truth)\n",
        "\n",
        "        # 2. Identify initial Alpha, Beta, Delta\n",
        "        sorted_idx = np.argsort(fitness)[::-1]\n",
        "        alpha_pos, alpha_score = wolves[sorted_idx[0]], fitness[sorted_idx[0]]\n",
        "        beta_pos, beta_score = wolves[sorted_idx[1]], fitness[sorted_idx[1]]\n",
        "        delta_pos, delta_score = wolves[sorted_idx[2]], fitness[sorted_idx[2]]\n",
        "\n",
        "        # 3. Main Hunting Loop\n",
        "        for it in range(1, self.max_iter + 1):\n",
        "            a = 2.0 - it * (2.0 / self.max_iter)  # Linearly decreases from 2 to 0\n",
        "\n",
        "            for i in range(self.num_wolves):\n",
        "                # Update with respect to Alpha\n",
        "                r1, r2 = np.random.rand(), np.random.rand()\n",
        "                A1 = 2.0 * a * r1 - a\n",
        "                C1 = 2.0 * r2\n",
        "                D_alpha = abs(C1 * alpha_pos - wolves[i])\n",
        "                X1 = alpha_pos - A1 * D_alpha\n",
        "\n",
        "                # Update with respect to Beta\n",
        "                r1, r2 = np.random.rand(), np.random.rand()\n",
        "                A2 = 2.0 * a * r1 - a\n",
        "                C2 = 2.0 * r2\n",
        "                D_beta = abs(C2 * beta_pos - wolves[i])\n",
        "                X2 = beta_pos - A2 * D_beta\n",
        "\n",
        "                # Update with respect to Delta\n",
        "                r1, r2 = np.random.rand(), np.random.rand()\n",
        "                A3 = 2.0 * a * r1 - a\n",
        "                C3 = 2.0 * r2\n",
        "                D_delta = abs(C3 * delta_pos - wolves[i])\n",
        "                X3 = delta_pos - A3 * D_delta\n",
        "\n",
        "                # Position update: average of Alpha, Beta, Delta vectors\n",
        "                new_pos = (X1 + X2 + X3) / 3.0\n",
        "                wolves[i] = np.clip(new_pos, self.search_min, self.search_max)\n",
        "\n",
        "                # Evaluate fitness\n",
        "                score = self._fitness_function(wolves[i], reconstruction_errors, ground_truth)\n",
        "                fitness[i] = score\n",
        "\n",
        "                # Update Alpha, Beta, Delta hierarchy\n",
        "                if score > alpha_score:\n",
        "                    alpha_score = score\n",
        "                    alpha_pos = wolves[i]\n",
        "                elif score > beta_score:\n",
        "                    beta_score = score\n",
        "                    beta_pos = wolves[i]\n",
        "                elif score > delta_score:\n",
        "                    delta_score = score\n",
        "                    delta_pos = wolves[i]\n",
        "\n",
        "            if it % 5 == 0 or it == self.max_iter:\n",
        "                print(f\"  ── Iteration {it:02d}/{self.max_iter:02d} | Alpha Threshold (τ): {alpha_pos:.5f} | Peak F2-Score: {alpha_score:.4f}\")\n",
        "\n",
        "        print(f\"[GWO Engine] Optimal Anomaly Cutoff Found: τ_opt = {alpha_pos:.5f} (F2 = {alpha_score:.4f})\")\n",
        "        return alpha_pos\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 6. DUAL-LAYER INFERENCE & SHAP ENGINE\n",
        "# =====================================================================\n",
        "class DualLayerPipeline:\n",
        "    def __init__(self, global_model, antenna_engine, feature_names, initial_threshold=1.5):\n",
        "        self.model = global_model\n",
        "        self.antenna = antenna_engine\n",
        "        self.feature_names = feature_names\n",
        "        self.threshold = initial_threshold\n",
        "\n",
        "    def evaluate_transaction(self, tx_vector, physical_distance_m):\n",
        "        self.model.eval()\n",
        "        tx_tensor = torch.tensor(tx_vector.reshape(1, -1), dtype=torch.float32)\n",
        "        with torch.no_grad():\n",
        "            recon = self.model(tx_tensor)\n",
        "            mse_loss = float(torch.mean((tx_tensor - recon)**2).item())\n",
        "\n",
        "        measured_rssi = self.antenna.compute_received_rssi(distance_m=physical_distance_m)\n",
        "\n",
        "        # Valid near-field physical presence window (>= -25.0 dBm within ~0.5m)\n",
        "        rf_verified = (measured_rssi >= -25.0)\n",
        "        ml_anomalous = (mse_loss > self.threshold)\n",
        "\n",
        "        # Contextual Decision Engine\n",
        "        if not ml_anomalous and rf_verified:\n",
        "            verdict = \"LOW RISK (Approved)\"\n",
        "            action = \"AUTO_APPROVE\"\n",
        "        elif ml_anomalous and rf_verified:\n",
        "            verdict = \"MEDIUM RISK (Behavioral Shift / Travel)\"\n",
        "            action = \"STEP_UP_CHALLENGE_SMS\"\n",
        "        elif ml_anomalous and not rf_verified:\n",
        "            verdict = \"HIGH RISK (Rogue / Remote Compromised Token)\"\n",
        "            action = \"IMMEDIATE_BLOCK\"\n",
        "        else:\n",
        "            verdict = \"MEDIUM RISK (Suspicious Physical Node)\"\n",
        "            action = \"MANUAL_REVIEW\"\n",
        "\n",
        "        return {\n",
        "            \"reconstruction_loss\": round(mse_loss, 5),\n",
        "            \"threshold\": round(self.threshold, 5),\n",
        "            \"measured_rssi_dbm\": measured_rssi,\n",
        "            \"rf_verified\": rf_verified,\n",
        "            \"ml_anomalous\": ml_anomalous,\n",
        "            \"verdict\": verdict,\n",
        "            \"action\": action\n",
        "        }\n",
        "\n",
        "    def explain(self, tx_vector, background_samples):\n",
        "        self.model.eval()\n",
        "        def model_err(data):\n",
        "            t = torch.tensor(data, dtype=torch.float32)\n",
        "            with torch.no_grad():\n",
        "                r = self.model(t)\n",
        "                return torch.sum((t - r)**2, dim=1).numpy()\n",
        "\n",
        "        explainer = shap.Explainer(model_err, background_samples[:50])\n",
        "        shap_values = explainer(tx_vector.reshape(1, -1))\n",
        "\n",
        "        vals = shap_values.values[0]\n",
        "        top_idx = np.argsort(vals)[::-1][:3]\n",
        "        return [(self.feature_names[i], round(float(vals[i]), 4)) for i in top_idx]\n",
        "\n",
